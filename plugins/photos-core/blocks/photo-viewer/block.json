{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "photos/photo-viewer",
	"title": "Photo Viewer",
	"category": "media",
	"icon": "format-gallery",
	"description": "Opens photos from the grid full-screen, with their details and previous/next navigation.",
	"textdomain": "photos-core",
	"supports": {
		"html": false,
		"interactivity": true,
		"multiple": false,
		"reusable": false
	},
	"editorScript": "file:./edit.js",
	"viewScriptModule": "file:./view.js",
	"style": [ "photos-viewer" ],
	"render": "file:./render.php"
}
