# Copy to .deploy.env (not committed) to customize `npm run deploy`.

# SSH user@host, from WordPress.com > your site > Settings > SFTP/SSH.
WPCOM_SSH_HOST="miguelrojasphoto.wordpress.com@ssh.wp.com"

# Optional: always use this key (attached to the site in WordPress.com), even if
# ~/.ssh/config picks another identity for ssh.wp.com.
# WPCOM_SSH_KEY="$HOME/.ssh/id_ed25519"
